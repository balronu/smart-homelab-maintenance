[Unit]
Description=Smart Homelab Maintenance fixed LXC discovery (opt-in)
After=local-fs.target
ConditionPathExists=/usr/libexec/smart-homelab-maintenance/lxc-discovery.py

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/libexec/smart-homelab-maintenance/lxc-discovery.py
# Let Python unwind through serve()'s finally block so the fixed socket is
# removed before a controlled restart can bind it again.
KillSignal=SIGINT
# The application owns its fixed socket and shared parent directory. systemd
# must not remove or re-own the other service's socket during a restart.
UMask=0007
# pct exec needs root namespace setup for unprivileged LXCs; all other
# filesystem, network and fixed-probe restrictions remain enforced below.
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# pct exec needs AF_INET for Proxmox cluster transport; keep all other
# address-family restrictions in place.
RestrictAddressFamilies=AF_UNIX AF_INET
ReadOnlyPaths=/usr/libexec/smart-homelab-maintenance/lxc-discovery.py
Restart=on-failure
RestartPreventExitStatus=SIGINT 130
RestartSec=5

[Install]
WantedBy=multi-user.target
