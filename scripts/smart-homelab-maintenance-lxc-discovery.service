[Unit]
Description=Smart Homelab Maintenance fixed LXC discovery (opt-in)
After=local-fs.target
ConditionPathExists=/usr/libexec/smart-homelab-maintenance/lxc-discovery.py

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/libexec/smart-homelab-maintenance/lxc-discovery.py
# The helper unit is the sole systemd owner of the shared runtime directory.
# Discovery creates and owns only its socket inside that directory; declaring
# the same RuntimeDirectory here would re-apply systemd ownership to the
# helper socket whenever Discovery starts.
UMask=0007
# pct exec needs root namespace setup for unprivileged LXCs; all other
# filesystem, network and fixed-probe restrictions remain enforced below.
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# pct exec needs AF_INET for Proxmox cluster transport; keep all other
# address-family restrictions in place.
RestrictAddressFamilies=AF_UNIX AF_INET
ReadOnlyPaths=/usr/libexec/smart-homelab-maintenance/lxc-discovery.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
